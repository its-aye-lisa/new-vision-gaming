{{define "mexicantrain_board.tmpl"}}
<div id="mt-board"
     {{if and (eq .Mode "2p") (not .IsMyTurn) (not .MatchOver)}}
       hx-get="/hx/mt/state?room={{.RoomCode}}"
       hx-trigger="every 2s"
       hx-swap="outerHTML"
     {{end}}
     class="space-y-3">

  <!-- Compact Active-Match Header + Turn Controls (fits trains + hand above fold at 1280x800) -->
  <div class="flex items-center justify-between gap-2 flex-wrap border-b border-border-subtle pb-2">
    <div class="flex items-center gap-2 flex-wrap">
      <h1 class="text-base font-bold tracking-tight text-ink-primary">Mexican Train</h1>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold {{if .IsMyTurn}}bg-accent-primary text-ink-on-accent{{else}}bg-surface-cell text-ink-muted border border-border-subtle{{end}}">
        {{.TurnLabel}}
      </span>
    </div>
    <div class="flex items-center gap-2">
      {{if .CanDraw}}
      <button type="button"
              hx-post="/hx/mt/action"
              hx-vals='{"room":"{{.RoomCode}}","action":"DRAW"}'
              hx-target="#mt-board"
              hx-swap="outerHTML"
              class="px-3 py-1 rounded-control bg-accent-primary text-ink-on-accent text-xs font-bold hover:opacity-90 cursor-pointer">
        Draw Tile ({{.BoneyardCount}})
      </button>
      {{end}}
      {{if .CanPass}}
      <button type="button"
              hx-post="/hx/mt/action"
              hx-vals='{"room":"{{.RoomCode}}","action":"PASS"}'
              hx-target="#mt-board"
              hx-swap="outerHTML"
              class="px-3 py-1 rounded-control border border-status-warning bg-status-warning/10 text-status-warning text-xs font-bold hover:opacity-90 cursor-pointer">
        Pass &amp; Open Train
      </button>
      {{end}}
      <a href="/games/mexican-train" class="px-2.5 py-1 rounded-control border border-border-subtle bg-surface-card text-xs font-semibold text-ink-muted hover:text-ink-primary hover:border-border-focus">
        New Match
      </a>
    </div>
  </div>

  <!-- Compact 4-Stat Scoreboard Strip -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center">
    <div class="rounded-control border border-border-subtle bg-surface-cell py-1.5 px-2.5">
      <div class="text-[11px] uppercase tracking-wider text-ink-muted">Engine</div>
      <div class="text-sm font-mono font-bold text-ink-primary">[{{.Engine}}|{{.Engine}}] &middot; <span class="text-xs font-normal text-ink-muted">{{.HandNumber}}/{{.TotalHands}}</span></div>
    </div>
    <div class="rounded-control border border-border-subtle bg-surface-cell py-1.5 px-2.5">
      <div class="text-[11px] uppercase tracking-wider text-ink-muted">{{.MyName}}</div>
      <div class="text-sm font-mono font-bold text-player-x">{{.MyScore}} pts <span class="text-xs font-normal text-ink-muted">&middot; {{len .MyHand}}</span></div>
    </div>
    <div class="rounded-control border border-border-subtle bg-surface-cell py-1.5 px-2.5">
      <div class="text-[11px] uppercase tracking-wider text-ink-muted">{{.OppName}}</div>
      <div class="text-sm font-mono font-bold text-player-o">{{.OppScore}} pts <span class="text-xs font-normal text-ink-muted">&middot; {{.OppTileCount}}</span></div>
    </div>
    <div class="rounded-control border border-border-subtle bg-surface-cell py-1.5 px-2.5">
      <div class="text-[11px] uppercase tracking-wider text-ink-muted">Boneyard</div>
      <div class="text-sm font-mono font-bold text-ink-primary">{{.BoneyardCount}} <span class="text-xs font-normal text-ink-muted">&middot; {{if .IsSolo}}Double-{{.MaxPip}}{{else}}{{.RoomCode}}{{end}}</span></div>
    </div>
  </div>

  <!-- 2-Player Invite Share Strip (Full URL + Strict-CSP Copy Button + Incognito Tip) -->
  {{if eq .Mode "2p"}}
  <div class="rounded-control border border-border-focus/60 bg-surface-cell-hover px-3 py-2 space-y-1.5 text-xs">
    <div class="flex items-center justify-between gap-2 flex-wrap">
      <div class="flex items-center gap-2 flex-1 min-w-0">
        <span class="font-bold text-ink-primary whitespace-nowrap">2-Player Invite:</span>
        <input type="text"
               readonly
               value="{{.ShareURL}}"
               data-select-on-click="true"
               aria-label="2-Player Invite URL"
               class="flex-1 min-w-0 font-mono text-xs px-2 py-1 rounded border border-border-subtle bg-surface-card text-ink-primary" />
      </div>
      <button type="button"
              data-copy-text="{{.ShareURL}}"
              class="whitespace-nowrap px-3 py-1 rounded-control bg-accent-primary text-ink-on-accent text-xs font-bold hover:opacity-90 cursor-pointer">
        Copy Link
      </button>
    </div>
    <div class="text-[11px] text-ink-muted">
      {{if .WaitingForPlayer2}}
        Waiting for Player 2. Testing locally? Open in an <strong>Incognito window</strong> or second device so Player 2 gets a separate seat cookie.
      {{else}}
        Both seats connected &bull; Hidden hands isolated per seat cookie.
      {{end}}
    </div>
  </div>
  {{end}}

  {{if .OpenDoubleLabel}}
  <div class="rounded-control border border-status-danger bg-status-danger/10 px-3 py-1.5 text-xs font-bold text-status-danger">
    OPEN DOUBLE ACTIVE: Must satisfy the double on {{.OpenDoubleLabel}} before any other train!
  </div>
  {{end}}

  {{if .Notice}}
  <div class="rounded-control border border-status-warning/50 bg-status-warning/10 px-3 py-1.5 text-xs text-status-warning font-medium">
    {{.Notice}}
  </div>
  {{end}}

  <!-- Natural Between-Hand Scoreboard + Zero-CLS Between-Hand Ad Slot -->
  {{if .HandOver}}
  <div class="rounded-card border border-status-verified/50 bg-status-verified/10 p-3.5 space-y-2.5 text-center">
    <div class="text-sm font-bold text-ink-primary">{{.WinnerBanner}}</div>
    <div class="text-xs text-ink-muted">
      Cumulative Scores (Lowest Wins): <strong class="text-player-x">{{.MyName}} {{.MyScore}}</strong> &bull;
      <strong class="text-player-o">{{.OppName}} {{.OppScore}}</strong>
    </div>

    {{if not .IsNativeShell}}
    <div id="nvg-post-match-banner" data-nvg-ad-slot="post-match-banner" data-nvg-ad-event="round-complete"
         class="w-full min-h-[100px] rounded-control border border-dashed border-border-subtle bg-surface-card/80 flex items-center justify-center text-xs font-mono text-ink-muted">
      {{if .WebAdsEnabled}}
        <ins class="adsbygoogle block w-full min-h-[100px]" data-ad-client="{{.AdSenseClient}}" data-ad-slot="post-match-banner" data-ad-format="horizontal" data-full-width-responsive="true"></ins>
      {{else}}
        BETWEEN-HAND AD SLOT (Zero-CLS 336&times;280 / H5 adBreak() SafeFrame)
      {{end}}
    </div>
    {{end}}

    <div>
      {{if not .MatchOver}}
      <button type="button"
              hx-post="/hx/mt/next-hand"
              hx-vals='{"room":"{{.RoomCode}}"}'
              hx-target="#mt-board"
              hx-swap="outerHTML"
              class="px-4 py-1.5 rounded-control bg-status-verified text-ink-inverse text-xs font-bold hover:opacity-90 cursor-pointer">
        Deal Next Hand (Engine [{{.NextEngine}}|{{.NextEngine}}])
      </button>
      {{else}}
      <a href="/games/mexican-train" class="inline-block px-4 py-1.5 rounded-control bg-accent-primary text-ink-on-accent text-xs font-bold">
        Play Another Match
      </a>
      {{end}}
    </div>
  </div>
  {{end}}

  <!-- 3 Tabletop Domino Train Lanes -->
  <div class="space-y-2">
    {{range .Trains}}
    <div class="rounded-cell border-2 border-dashed {{if .NeedsDouble}}border-status-danger bg-status-danger/10{{else if .Playable}}border-accent-primary bg-surface-cell-hover{{else}}border-border-subtle bg-surface-cell{{end}} px-3 py-2">
      <div class="flex items-center justify-between gap-2 flex-wrap mb-1.5">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full {{.DotClass}}" aria-hidden="true"></span>
          <span class="text-xs font-bold text-ink-primary">{{.Title}}</span>
          {{if .NeedsDouble}}
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-status-danger/15 text-status-danger font-bold">MUST COVER DOUBLE</span>
          {{else if .Public}}
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-status-warning/15 text-status-warning font-bold">OPEN TRAIN</span>
          {{else}}
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-surface-card border border-border-subtle text-ink-muted">PRIVATE</span>
          {{end}}
        </div>
        <span class="text-xs font-mono font-bold text-ink-primary">Open End: <span class="text-accent-primary">{{.OpenEnd}}</span></span>
      </div>
      <div class="flex items-center gap-1.5 overflow-x-auto pb-0.5">
        {{template "domino_tile.tmpl" (tileVM $.Engine $.Engine true "board")}}
        {{if eq .TileCount 0}}
          <span class="text-ink-muted italic text-xs pl-1">Start train &mdash; match {{.OpenEnd}}</span>
        {{else}}
          {{range .Tiles}}
            {{template "domino_tile.tmpl" (tileVM .Left .Right (eq .Left .Right) "board")}}
          {{end}}
        {{end}}
      </div>
    </div>
    {{end}}
  </div>

  <!-- Compact Wrapping Flex Hand Tray (Vertical Color-Coded Dominoes, No "No match" Spam) -->
  <div class="space-y-1.5">
    <div class="flex items-center justify-between gap-2 flex-wrap">
      <h2 class="text-xs font-bold uppercase tracking-wider text-ink-primary">Your Hand ({{len .MyHand}} tiles)</h2>
      <span class="text-[11px] text-ink-muted">Highlighted dominoes are playable &mdash; click a train pill below to play</span>
    </div>
    <div class="flex flex-wrap gap-2 items-start rounded-cell border border-border-subtle bg-surface-cell/60 p-2.5">
      {{range .MyHand}}
      <div class="flex flex-col items-center gap-1 {{if .Options}}opacity-100{{else}}opacity-45{{end}}">
        <div class="rounded-tile {{if .Options}}ring-2 ring-accent-primary/80 hover:-translate-y-0.5 hover:shadow-lg transition-transform{{end}}">
          {{template "domino_tile.tmpl" (tileVM .Left .Right true "hand")}}
        </div>
        {{if .Options}}
        <div class="flex flex-col items-center gap-1">
          {{$tileIdx := .Index}}
          {{$room := $.RoomCode}}
          {{range .Options}}
          <button type="button"
                  hx-post="/hx/mt/action"
                  hx-vals='{"room":"{{$room}}","action":"PLAY","tileIndex":"{{$tileIdx}}","targetTrain":"{{.TargetTrain}}"}'
                  hx-target="#mt-board"
                  hx-swap="outerHTML"
                  class="whitespace-nowrap px-1.5 py-0.5 rounded bg-accent-primary text-ink-on-accent text-[10px] font-bold hover:opacity-90 cursor-pointer">
            &rarr; {{.Label}}
          </button>
          {{end}}
        </div>
        {{end}}
      </div>
      {{end}}
    </div>
  </div>

  <!-- Compact Play-by-Play Table Log -->
  {{if .RecentLog}}
  <div class="rounded-control border border-border-subtle bg-surface-cell/50 px-3 py-2 text-[11px] font-mono text-ink-muted space-y-0.5">
    <div class="font-bold text-ink-primary uppercase tracking-wider">Table Log</div>
    {{range .RecentLog}}
    <div>&bull; {{.}}</div>
    {{end}}
  </div>
  {{end}}
</div>
{{end}}

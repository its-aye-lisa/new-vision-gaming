{{define "mexicantrain_board.tmpl"}}
<div id="mt-board"
     {{if and (eq .Mode "2p") (not .IsMyTurn) (not .MatchOver)}}
       hx-get="/hx/mt/state?room={{.RoomCode}}"
       hx-trigger="every 2s"
       hx-swap="outerHTML"
     {{end}}
     class="space-y-5">

  <!-- Match Status & Scoreboard Header -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
    <div class="rounded-control border border-border-subtle bg-surface-cell p-2.5">
      <div class="text-[11px] uppercase tracking-wider text-ink-muted">Engine</div>
      <div class="text-lg font-mono font-bold text-accent-primary">[{{.Engine}}|{{.Engine}}]</div>
      <div class="text-[11px] text-ink-muted">Hand {{.HandNumber}} / {{.TotalHands}}</div>
    </div>
    <div class="rounded-control border border-border-subtle bg-surface-cell p-2.5">
      <div class="text-[11px] uppercase tracking-wider text-ink-muted">{{.MyName}}</div>
      <div class="text-lg font-mono font-bold text-player-x">{{.MyScore}} pts</div>
      <div class="text-[11px] text-ink-muted">{{len .MyHand}} tiles left</div>
    </div>
    <div class="rounded-control border border-border-subtle bg-surface-cell p-2.5">
      <div class="text-[11px] uppercase tracking-wider text-ink-muted">{{.OppName}}</div>
      <div class="text-lg font-mono font-bold text-player-o">{{.OppScore}} pts</div>
      <div class="text-[11px] text-ink-muted">{{.OppTileCount}} tiles left</div>
    </div>
    <div class="rounded-control border border-border-subtle bg-surface-cell p-2.5">
      <div class="text-[11px] uppercase tracking-wider text-ink-muted">Boneyard</div>
      <div class="text-lg font-mono font-bold text-ink-primary">{{.BoneyardCount}}</div>
      <div class="text-[11px] font-mono text-ink-muted">{{.RoomCode}}</div>
    </div>
  </div>

  <!-- 2-Player Invite Share Strip -->
  {{if eq .Mode "2p"}}
  <div class="rounded-control border border-border-focus/50 bg-accent-primary/10 px-3 py-2.5 flex items-center justify-between gap-3 flex-wrap text-xs">
    <div>
      <span class="font-bold text-ink-primary">2-Player Invite Link:</span>
      <span class="font-mono text-accent-primary ml-1">{{.SharePath}}</span>
    </div>
    <span class="text-ink-muted">
      {{if .WaitingForPlayer2}}Share this link with Player 2 to begin!{{else}}Both seats connected &bull; Hidden hands isolated{{end}}
    </span>
  </div>
  {{end}}

  <!-- Turn / Open Double / Notice Banners -->
  <div class="flex items-center justify-between gap-2 flex-wrap">
    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold {{if .IsMyTurn}}bg-status-verified/20 text-status-verified border border-status-verified/40{{else}}bg-surface-cell text-ink-muted border border-border-subtle{{end}}">
      {{.TurnLabel}}
    </span>
    <div class="flex items-center gap-2">
      {{if .CanDraw}}
      <button type="button"
              hx-post="/hx/mt/action"
              hx-vals='{"room":"{{.RoomCode}}","action":"DRAW"}'
              hx-target="#mt-board"
              hx-swap="outerHTML"
              class="px-3 py-1.5 rounded-control bg-player-o text-ink-inverse text-xs font-bold hover:opacity-90 cursor-pointer">
        Draw Tile ({{.BoneyardCount}})
      </button>
      {{end}}
      {{if .CanPass}}
      <button type="button"
              hx-post="/hx/mt/action"
              hx-vals='{"room":"{{.RoomCode}}","action":"PASS"}'
              hx-target="#mt-board"
              hx-swap="outerHTML"
              class="px-3 py-1.5 rounded-control border border-status-warning/50 bg-status-warning/15 text-status-warning text-xs font-bold hover:opacity-90 cursor-pointer">
        Pass &amp; Open Train
      </button>
      {{end}}
      <a href="/games/mexican-train" class="px-2.5 py-1.5 rounded-control border border-border-subtle text-xs text-ink-muted hover:text-ink-primary">
        New Match
      </a>
    </div>
  </div>

  {{if .OpenDoubleLabel}}
  <div class="rounded-control border border-status-danger/50 bg-status-danger/15 px-3 py-2 text-xs font-bold text-status-danger">
    OPEN DOUBLE ACTIVE: Must satisfy the double on {{.OpenDoubleLabel}} before any other train!
  </div>
  {{end}}

  {{if .Notice}}
  <div class="rounded-control border border-status-warning/40 bg-status-warning/10 px-3 py-2 text-xs text-status-warning font-medium">
    {{.Notice}}
  </div>
  {{end}}

  <!-- Natural Between-Hand Scoreboard + Zero-CLS Between-Hand Ad Slot (CardGames.io High-RPM Playbook) -->
  {{if .HandOver}}
  <div class="rounded-card border border-status-verified/50 bg-status-verified/10 p-4 space-y-3 text-center">
    <div class="text-base font-bold text-ink-primary">{{.WinnerBanner}}</div>
    <div class="text-xs text-ink-muted">
      Cumulative Scores (Lowest Wins): <strong class="text-player-x">{{.MyName}} {{.MyScore}}</strong> &bull;
      <strong class="text-player-o">{{.OppName}} {{.OppScore}}</strong>
    </div>

    {{if not .IsNativeShell}}
    <div id="nvg-post-match-banner" data-nvg-ad-slot="post-match-banner" data-nvg-ad-event="round-complete"
         class="w-full min-h-[100px] rounded-control border border-dashed border-border-subtle bg-surface-card/60 flex items-center justify-center text-xs font-mono text-ink-muted">
      {{if .WebAdsEnabled}}
        <ins class="adsbygoogle block w-full min-h-[100px]" data-ad-client="{{.AdSenseClient}}" data-ad-slot="post-match-banner" data-ad-format="horizontal" data-full-width-responsive="true"></ins>
      {{else}}
        BETWEEN-HAND AD SLOT (Zero-CLS 336&times;280 / H5 adBreak() SafeFrame)
      {{end}}
    </div>
    {{end}}

    <div class="pt-1">
      {{if not .MatchOver}}
      <button type="button"
              hx-post="/hx/mt/next-hand"
              hx-vals='{"room":"{{.RoomCode}}"}'
              hx-target="#mt-board"
              hx-swap="outerHTML"
              class="px-4 py-2 rounded-control bg-status-verified text-ink-inverse text-xs font-bold hover:opacity-90 cursor-pointer">
        Deal Next Hand (Engine [{{.Engine}} &rarr; Next])
      </button>
      {{else}}
      <a href="/games/mexican-train" class="inline-block px-4 py-2 rounded-control bg-accent-primary text-ink-inverse text-xs font-bold">
        Play Another Match
      </a>
      {{end}}
    </div>
  </div>
  {{end}}

  <!-- 3 Domino Train Lanes -->
  <div class="space-y-2.5">
    {{range .Trains}}
    <div class="rounded-cell border {{if .NeedsDouble}}border-status-danger bg-status-danger/10{{else if .Public}}border-border-focus/60 bg-surface-cell{{else}}border-border-subtle bg-surface-cell/70{{end}} p-3">
      <div class="flex items-center justify-between gap-2 flex-wrap mb-2">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-ink-primary">{{.Title}}</span>
          {{if .NeedsDouble}}
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-status-danger/20 text-status-danger font-bold">MUST COVER DOUBLE</span>
          {{else if .Public}}
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-status-warning/20 text-status-warning font-bold">OPEN TRAIN</span>
          {{else}}
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-surface-card text-ink-muted">PRIVATE</span>
          {{end}}
        </div>
        <span class="text-xs font-mono font-bold text-accent-primary">Open End: {{.OpenEnd}}</span>
      </div>
      <div class="flex items-center gap-1.5 flex-wrap font-mono text-xs">
        <span class="px-2 py-1 rounded bg-surface-card border border-border-subtle text-ink-muted">HUB</span>
        {{if eq .TileCount 0}}
          <span class="text-ink-muted italic text-[11px]">No tiles yet &mdash; match {{.OpenEnd}}</span>
        {{else}}
          {{range .Tiles}}
            <span class="inline-flex items-center rounded border border-border-subtle bg-surface-card px-2 py-1 text-ink-primary font-bold">
              <span>{{.Left}}</span><span class="mx-1 text-border-subtle">|</span><span>{{.Right}}</span>
            </span>
          {{end}}
        {{end}}
      </div>
    </div>
    {{end}}
  </div>

  <!-- Player's Private Domino Hand -->
  <div class="space-y-2">
    <div class="flex items-center justify-between">
      <h3 class="text-xs font-bold uppercase tracking-wider text-ink-primary">Your Private Hand ({{len .MyHand}} tiles)</h3>
      <span class="text-[11px] text-ink-muted">Click a highlighted train button below a tile to play</span>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5">
      {{range .MyHand}}
      <div class="rounded-cell border {{if .Options}}border-border-focus bg-surface-cell-hover{{else}}border-border-subtle bg-surface-cell/60 opacity-75{{end}} p-2.5 flex flex-col items-center gap-2">
        <div class="flex items-center justify-center rounded-control border {{if .Double}}border-player-o{{else}}border-border-subtle{{end}} bg-surface-card px-3 py-1.5 font-mono text-base font-bold text-ink-primary w-full">
          <span>{{.Left}}</span>
          <span class="mx-2 text-border-subtle">|</span>
          <span>{{.Right}}</span>
        </div>
        {{if .Options}}
        <div class="flex flex-wrap justify-center gap-1 w-full">
          {{$tileIdx := .Index}}
          {{$room := $.RoomCode}}
          {{range .Options}}
          <button type="button"
                  hx-post="/hx/mt/action"
                  hx-vals='{"room":"{{$room}}","action":"PLAY","tileIndex":"{{$tileIdx}}","targetTrain":"{{.TargetTrain}}"}'
                  hx-target="#mt-board"
                  hx-swap="outerHTML"
                  class="px-2 py-1 rounded bg-accent-primary text-ink-inverse text-[10px] font-bold hover:opacity-90 cursor-pointer">
            &rarr; {{.Label}}
          </button>
          {{end}}
        </div>
        {{else}}
        <span class="text-[10px] text-ink-muted font-mono">No match</span>
        {{end}}
      </div>
      {{end}}
    </div>
  </div>

  <!-- Recent Play-by-Play Feed -->
  {{if .RecentLog}}
  <div class="rounded-control border border-border-subtle bg-surface-cell/50 p-3 text-[11px] font-mono text-ink-muted space-y-1">
    <div class="font-bold text-ink-primary uppercase tracking-wider">Table Log</div>
    {{range .RecentLog}}
    <div>&bull; {{.}}</div>
    {{end}}
  </div>
  {{end}}
</div>
{{end}}

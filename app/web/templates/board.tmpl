{{define "board.tmpl"}}
<div class="space-y-4">
  <div class="text-center">
    {{if eq .Status "WIN"}}
      <div class="inline-block px-3 py-1 rounded-control text-sm font-bold bg-status-verified/15 text-status-verified border border-status-verified/40">
        Winner: Player {{.Winner}}
      </div>
    {{else if eq .Status "DRAW"}}
      <div class="inline-block px-3 py-1 rounded-control text-sm font-bold bg-status-warning/15 text-status-warning border border-status-warning/40">
        Match Drawn (Terminal Immutability Enforced)
      </div>
    {{else}}
      <div class="text-sm font-semibold text-ink-muted">
        Next Turn:
        <span class="{{if eq .Turn "X"}}text-player-x{{else}}text-player-o{{end}} font-bold">{{.Turn}}</span>
      </div>
    {{end}}

    {{if .Notice}}
      <div class="mt-2 text-xs font-mono text-status-danger">{{.Notice}}</div>
    {{end}}
  </div>

  <div class="grid grid-cols-3 gap-2.5 max-w-[280px] mx-auto" role="grid" aria-label="Tic-Tac-Toe Board">
    {{range .Cells}}
      <form hx-post="/hx/move" hx-target="#game-surface" hx-swap="innerHTML">
        <input type="hidden" name="board" value="{{$.Board}}" />
        <input type="hidden" name="player" value="{{$.Turn}}" />
        <input type="hidden" name="position" value="{{.Index}}" />
        <input type="hidden" name="actor" value="htmx-player" />
        <button
          type="submit"
          {{if or $.GameOver (ne .Mark "")}}disabled{{end}}
          aria-label="Cell {{.Index}} {{if .Mark}}{{.Mark}}{{else}}empty{{end}}"
          class="w-full aspect-square rounded-cell border border-border-subtle bg-surface-cell hover:bg-surface-cell-hover hover:border-border-focus disabled:opacity-90 disabled:hover:bg-surface-cell disabled:hover:border-border-subtle disabled:cursor-default transition-colors flex items-center justify-center text-4xl font-extrabold {{if eq .Mark "X"}}text-player-x{{else if eq .Mark "O"}}text-player-o{{else}}text-ink-muted{{end}}"
        >
          {{.Mark}}
        </button>
      </form>
    {{end}}
  </div>

  <div class="text-center">
    <button
      type="button"
      hx-post="/hx/reset"
      hx-target="#game-surface"
      hx-swap="innerHTML"
      class="px-4 py-2 rounded-control bg-accent-primary text-ink-on-accent font-bold text-sm hover:opacity-90 transition-opacity cursor-pointer"
    >
      New Match
    </button>
  </div>
</div>
{{end}}

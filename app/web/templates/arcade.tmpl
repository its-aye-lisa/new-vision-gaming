{{define "arcade.tmpl"}}
<div class="space-y-6">
  <div>
    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-status-verified/15 text-status-verified border border-status-verified/35">
      CLASSIC GAMES SUITE &bull; FIREBASE POWERED
    </span>
    <h1 class="text-2xl font-bold tracking-tight text-ink-primary mt-2">New Vision Gaming Arcade</h1>
    <p class="text-sm text-ink-muted mt-1">
      Instant-load, zero-bloat classic strategy games engineered with verifiable pure kernels and ad-friendly, distraction-free layouts.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <a href="/games/tictactoe" class="block rounded-cell border border-border-focus bg-surface-cell hover:bg-surface-cell-hover p-4 transition-colors">
      <div class="flex items-center justify-between">
        <h2 class="font-bold text-ink-primary">Tic-Tac-Toe</h2>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-status-verified/15 text-status-verified">LIVE</span>
      </div>
      <p class="text-xs text-ink-muted mt-1.5">3&times;3 classic strategy. Exhaustively verified across all 4,520 reachable states. Play via Web, HTMX, or A2A Agent.</p>
    </a>

    <a href="/games/mexican-train" class="block rounded-cell border border-status-verified bg-surface-cell hover:bg-surface-cell-hover p-4 transition-colors">
      <div class="flex items-center justify-between gap-2">
        <h2 class="font-bold text-ink-primary">Mexican Train Dominoes</h2>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-status-verified/15 text-status-verified">LIVE &bull; FLAGSHIP</span>
      </div>
      <p class="text-xs text-ink-muted mt-1.5">Double-9 &amp; Double-12 classic dominoes with 2-player 6-letter invite rooms (/play/MEX-XXXX), smart bot, and 3-way Go/GCC/Clang verification.</p>
    </a>

    <div class="rounded-cell border border-border-subtle bg-surface-cell/60 p-4 opacity-80">
      <div class="flex items-center justify-between gap-2">
        <h2 class="font-bold text-ink-primary">Chickenfoot &amp; All-Fives</h2>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-surface-card text-ink-muted">PHASE 2</span>
      </div>
      <p class="text-xs text-ink-muted mt-1.5">Shared dominoes engine expansion: branching Chickenfoot doubles and fast-paced 2-player All-Fives scoring.</p>
    </div>

    <div class="rounded-cell border border-border-subtle bg-surface-cell/60 p-4 opacity-80">
      <div class="flex items-center justify-between gap-2">
        <h2 class="font-bold text-ink-primary">Classic Backgammon</h2>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-surface-card text-ink-muted">PHASE 2</span>
      </div>
      <p class="text-xs text-ink-muted mt-1.5">Head-to-head 2-player strategy with server-verified CSPRNG FIPS dice, doubling cube, and zero-CLS board layout.</p>
    </div>
  </div>
</div>
{{end}}

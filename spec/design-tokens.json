{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "name": "New Vision Gaming Tabletop Design System",
    "version": "2.0.0",
    "standard": "W3C Design Tokens Community Group (DTCG)",
    "sourceOfTruth": "spec/design-tokens.json",
    "designDoc": "spec/DESIGN.md",
    "cssTarget": "app/web/styles/input.css"
  },
  "color": {
    "surface": {
      "canvas": { "$type": "color", "$value": "#f1f2f4" },
      "card": { "$type": "color", "$value": "#ffffff" },
      "cell": { "$type": "color", "$value": "#e9eef3" },
      "cellHover": { "$type": "color", "$value": "#fdf4e3" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#c2ccd6" },
      "focus": { "$type": "color", "$value": "#e99225" }
    },
    "ink": {
      "primary": { "$type": "color", "$value": "#2e3138" },
      "muted": { "$type": "color", "$value": "#52677d" },
      "inverse": { "$type": "color", "$value": "#fefcf5" },
      "onAccent": { "$type": "color", "$value": "#1f1607" }
    },
    "accent": {
      "primary": { "$type": "color", "$value": "#e99225" },
      "goldSoft": { "$type": "color", "$value": "#e6c24d" },
      "playerX": { "$type": "color", "$value": "#0284c7" },
      "playerO": { "$type": "color", "$value": "#d97706" }
    },
    "status": {
      "verified": { "$type": "color", "$value": "#15803d" },
      "warning": { "$type": "color", "$value": "#b45309" },
      "danger": { "$type": "color", "$value": "#dc2626" }
    },
    "train": {
      "p1": { "$type": "color", "$value": "#249ed6" },
      "p2": { "$type": "color", "$value": "#26bf88" },
      "p3": { "$type": "color", "$value": "#e61445" },
      "p4": { "$type": "color", "$value": "#e7b008" },
      "mexican": { "$type": "color", "$value": "#5c6670" }
    },
    "domino": {
      "face": { "$type": "color", "$value": "#ffffff" },
      "divider": { "$type": "color", "$value": "#94a3b8" },
      "pip0": { "$type": "color", "$value": "#9ca3af" },
      "pip1": { "$type": "color", "$value": "#06b6d4" },
      "pip2": { "$type": "color", "$value": "#84cc16" },
      "pip3": { "$type": "color", "$value": "#ef4444" },
      "pip4": { "$type": "color", "$value": "#22c55e" },
      "pip5": { "$type": "color", "$value": "#3b82f6" },
      "pip6": { "$type": "color", "$value": "#eab308" },
      "pip7": { "$type": "color", "$value": "#f472b6" },
      "pip8": { "$type": "color", "$value": "#14b8a6" },
      "pip9": { "$type": "color", "$value": "#a855f7" },
      "pip10": { "$type": "color", "$value": "#f97316" },
      "pip11": { "$type": "color", "$value": "#000000" },
      "pip12": { "$type": "color", "$value": "#6b7280" }
    }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "0.75rem" },
    "cell": { "$type": "dimension", "$value": "0.5rem" },
    "control": { "$type": "dimension", "$value": "0.5rem" },
    "tile": { "$type": "dimension", "$value": "0.375rem" },
    "pill": { "$type": "dimension", "$value": "9999px" }
  },
  "shadow": {
    "card": { "$type": "shadow", "$value": "0 1px 3px 0 rgb(0 0 0 / 0.08), 0 1px 2px -1px rgb(0 0 0 / 0.06)" },
    "tile": { "$type": "shadow", "$value": "0 4px 6px -1px rgb(0 0 0 / 0.14), 0 2px 4px -2px rgb(0 0 0 / 0.10)" }
  },
  "typography": {
    "fontSans": { "$type": "fontFamily", "$value": "ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif" },
    "fontMono": { "$type": "fontFamily", "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace" }
  }
}

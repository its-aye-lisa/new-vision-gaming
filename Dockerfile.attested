# syntax=docker/dockerfile:1.7
# =============================================================================
# New Vision Gaming Arcade (nvg-arcade) — SI-7 Signed-Bundle Attested Image
# =============================================================================
# Packages the EXACT Clean-Room bit-for-bit verified dist/nvg-arcade binary
# produced by Enclaves A & B alongside its Ed25519 signed release bundle and
# public trust roots so SI-7 startup self-attestation matches 100%.
FROM scratch AS runtime

LABEL org.opencontainers.image.title="nvg-arcade" \
      org.opencontainers.image.description="New Vision Gaming Classic Games Suite (SI-7 Self-Attested FIPS 140-3 Release)" \
      gov.aegis.crypto.fips140="v1.0.0" \
      gov.aegis.memory_safety="go-no-unsafe-no-cgo"

COPY --chown=65532:65532 --chmod=0555 dist/nvg-arcade /nvg-arcade
COPY --chown=65532:65532 --chmod=0444 dist/release-bundle.signed.json /release-bundle.signed.json
COPY --chown=65532:65532 --chmod=0444 .factory-state/keys/trust-roots.json /trust-roots.json

ENV GODEBUG="fips140=on" \
    PORT="8080" \
    ADS_ENABLED="false"

USER 65532:65532
EXPOSE 8080

ENTRYPOINT ["/nvg-arcade"]
CMD ["--require-fips", "--bundle", "/release-bundle.signed.json", "--trust-roots", "/trust-roots.json"]
